{
  "name": "silent-calls",
  "version": "0.1.0",
  "private": true,
  "description": "Silent Calls desktop frontend",
  "author": "Silent Calls team",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "node scripts/start.mjs",
    "test": "tsx --test tests/*.test.ts tests/*.test.cjs",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "postinstall": "npm run prepare:assets"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@mediapipe/tasks-vision": "^1.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "org.silentcalls.desktop",
    "productName": "Silent Calls",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Silent Calls uses your camera to capture mouthed sentences.",
        "NSMicrophoneUsageDescription": "Silent Calls uses your microphone for optional voice enrollment."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ]
  },
  "type": "module"
}
