CARTESIA_API_KEY=sk_car_...
CARTESIA_VOICE_ID=            # from: python -m silentcalls.voice clone sample.wav --name You
TYPESAFE_API_KEY=             # Jev, direct
AI_GATEWAY_API_KEY=           # Jev through Vercel AI Gateway; used instead of TYPESAFE_API_KEY when set
VOCAB=                        # comma-separated names you often say (yours, contacts), e.g. Sarvajith,Nilesh
ANTHROPIC_API_KEY=sk-ant-...

# Audio devices: any substring of the names listed by `python -m sounddevice`
# Mac:     VIRTUAL_MIC_DEVICE=BlackHole 2ch   CALL_AUDIO_DEVICE=BlackHole 16ch
# Windows: VIRTUAL_MIC_DEVICE=CABLE Input     CALL_AUDIO_DEVICE=loopback  (records your speakers; no 2nd cable)
VIRTUAL_MIC_DEVICE=BlackHole 2ch
CALL_AUDIO_DEVICE=BlackHole 16ch

# Optional: phrase memory (Moss), remembers your replies to offer them again (portal.usemoss.dev)
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
